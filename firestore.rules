rules_version = '2';

// Deploy this from Firebase Console → Firestore Database → Rules,
// or with the Firebase CLI: `firebase deploy --only firestore:rules`
//
// Replace REPLACE_WITH_YOUR_ADMIN_UID below with your own Firebase Auth UID
// (Firebase Console → Authentication → Users, after you sign up once).
// This is what enforces "only I can add tools" — everyone else gets
// read-only access to the tools collection.

service cloud.firestore {
  match /databases/{database}/documents {

    // Each user can read and write ONLY their own profile document
    // (name, email, dob, phone). No one can read anyone else's data.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Everyone (including signed-out visitors) can read the tools list.
    // Only the admin UID can create, edit, or delete a tool.
    match /tools/{toolId} {
      allow read: if true;
      allow write: if request.auth != null
                    && request.auth.uid == "REPLACE_WITH_YOUR_ADMIN_UID";
    }
  }
}
